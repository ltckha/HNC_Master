<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Tự gom video sản phẩm (anh Kha "làm" 30/10): Tải về có video tên = mã → ổ Media/<MÃ>/. Chỉ Mac, không Claude. Luồng hàng mới nên chạy ngay
     khi Tải về đổi + mỗi 15 phút (ngoài khung 13–16h có lý do, luật 18). Cài: tools/launchd/cai_gom_video.sh -->
<dict>
  <key>Label</key><string>vn.giayhainancy.hnc.gomvideo</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/khan/Developer/HNC_Master/venv/bin/python</string>
    <string>/Users/khan/Developer/HNC_Master/tools/gom_video.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/khan/Developer/HNC_Master</string>
  <key>WatchPaths</key><array><string>/Users/khan/Downloads</string></array>
  <key>StartInterval</key><integer>900</integer>
  <key>ThrottleInterval</key><integer>90</integer>
  <key>StandardOutPath</key><string>/Users/khan/Library/Logs/hnc_gom_video.log</string>
  <key>StandardErrorPath</key><string>/Users/khan/Library/Logs/hnc_gom_video.log</string>
  <key>EnvironmentVariables</key><dict><key>PYTHONWARNINGS</key><string>ignore</string><key>PYTHONUNBUFFERED</key><string>1</string></dict>
